        tk.Label(container1, text="BPM Name:", font=font_small).grid(row=8, column=0)
        self.bpm_entry = tk.Entry(container1, font=font_small)
        self.bpm_entry.delete(0, tk.END)
        self.bpm_entry.insert(0,"HP203")
        self.bpm_entry.grid(row=8, column=1)

        tk.Button(container1, text="Analyse Single TBT", command=self.analyse_single, font=font_small).grid(row=9, column=0, columnspan=2, pady=5)

        # --- Container 2 ---
        container2 = tk.LabelFrame(self, text="Plot Settings", padx=10, pady=10, font=font_small)
        container2.grid(row=0, column=1, padx=5, pady=5, sticky="nsew")

        tk.Label(container2, text="Input 1:", font=font_small).grid(row=0, column=0)
        self.number_entry = tk.Entry(container2, font=font_small)
        self.number_entry.grid(row=0, column=1)

        tk.Label(container2, text="Input 2:", font=font_small).grid(row=1, column=0)
        self.name_entry = tk.Entry(container2, font=font_small)
        self.name_entry.grid(row=1, column=1)

        self.waveform_vars = {}
        self.xmin_entries = {}
        self.xmax_entries = {}

        for i in range(6):
            frame = tk.LabelFrame(container2, text=f"Graph {i+1}",font=font_small)
            frame.grid(row=2+i, column=0, columnspan=2, pady=2, sticky="w")
 #           frame.grid_propagate(False)    #  Bad idea!
            var_group = []
            for j, option in enumerate(self.waveform_options[i+1]):
                if (option=="None"):
                    tk.Label(frame,text="    ").grid(row=0,column=j)
                    continue
                var = tk.IntVar()
                var.set(1)
                tk.Checkbutton(frame, text=option, variable=var, font=font_small).grid(row=0, column=j, sticky="w")
                var_group.append(var)
            self.waveform_vars[i]=var_group

            xmiLbl=tk.Label(frame, text="Xmin:", font=font_small)
            xmiLbl.grid(row=0, column=3)
#            xmiLbl.place(relx=-3.0,rely=0.0,anchor='e')
            xmin = tk.Entry(frame, width=6, font=font_small)
            xmin.delete(0, tk.END)
            xmin.insert(0,"0.0")
#            xmin.place(relx=-2.0,rely=0.0,anchor='e')
            xmin.grid(row=0, column=4)
            self.xmin_entries[i]=xmin

            xmaLbl=tk.Label(frame, text="Xmax:", font=font_small)
            xmaLbl.grid(row=0, column=5)
#            xmaLbl.place(relx=-1.0,rely=0.0,anchor='e')
            xmax = tk.Entry(frame, width=6, font=font_small)
            xmax.delete(0, tk.END)
            xmax.insert(0,"1000.0")
            xmax.grid(row=0, column=6)
#            xmin.place(relx=0.0,rely=0.0,anchor='e')
            self.xmax_entries[i]=xmax

# --- Plot Area ---
        self.fig = plt.figure(figsize=(12, 5))
        self.axs = [self.fig.add_subplot(2, 3, i + 1) for i in range(5)]
        self.axs.append(self.fig.add_subplot(2, 3, 6, projection='polar'))
# HomeFrame
        # --- Container 3 ---
        container3 = tk.LabelFrame(self, text="Control Panel", padx=10, pady=10, font=font_small)
        container3.grid(row=0, column=2, padx=5, pady=5, sticky="nsew")

        tk.Button(container3, text="Update Plots", command=self.update_plots_t, font=font_small).pack(pady=5, fill='x')
        tk.Button(container3, text="Go to Plot Frame", command=lambda: self.controller.show_frame("PlotFrame"), font=font_small).pack(pady=5, fill='x')
        tk.Button(container3, text="Go to Dev Frame", command=lambda: self.controller.show_frame("DevFrame"), font=font_small).pack(pady=5, fill='x')
        tk.Button(container3, text="Exit", command=self.controller.quit, font=font_small).pack(pady=5, fill='x')

        # --- Container 4---
        container4 = tk.LabelFrame(self, text="Output Panel", padx=10, pady=10, font=font_small)
        container4.grid(row=0, column=3, padx=5, pady=5, sticky="nsew")

        tk.Label(container4, text="Seed tune:", font=font_small).grid(row=0, column=0)
        self.stune_var = tk.Entry(container4, font=font_small)
        self.stune_var.grid(row=0, column=1)
        self.stune_var.insert(0,"0.650")

        tk.Label(container4, text="New tune:", font=font_small).grid(row=1, column=0)
        self.ntune_var = tk.Entry(container4, font=font_small)
        self.ntune_var.grid(row=1, column=1)

        tk.Label(container4, text="Inj amp:", font=font_small).grid(row=2, column=0)
        self.ampin_var = tk.Entry(container4, font=font_small)
        self.ampin_var.grid(row=2, column=1)

        tk.Label(container4, text="Inj phase:", font=font_small).grid(row=3, column=0)
        self.phsin_var = tk.Entry(container4, font=font_small)
        self.phsin_var.grid(row=3, column=1)

        tk.Label(container4, text="Av inj amp:", font=font_small).grid(row=4, column=0)
        self.avampin_var = tk.Entry(container4, font=font_small)
        self.avampin_var.grid(row=4, column=1)

        tk.Label(container4, text="Av inj phase:", font=font_small).grid(row=5, column=0)
        self.avphsin_var = tk.Entry(container4, font=font_small)
        self.avphsin_var.grid(row=5, column=1)

        self.canvas = FigureCanvasTkAgg(self.fig, self)
        self.canvas.get_tk_widget().grid(row=1, column=0, columnspan=4, pady=10)

    def update_file_list(self):
        self.file_listbox.delete(0, tk.END)
        path='.'
        files=os.listdir(path)
        files_with_time=[(os.path.getctime(os.path.join(path,file)),file) for file in files]
        files_with_time.sort()
        sorted_files=[file for _, file in files_with_time]
#        for f in os.listdir('.'):
        for f in sorted_files:
            if f.endswith('.csv'):
                self.file_listbox.insert(tk.END, f)

    def on_file_select(self, event):
        widget = event.widget
        if widget.curselection():
            index = widget.curselection()[0]
            value = widget.get(index)
            self.file_entry.delete(0, tk.END)
            self.file_entry.insert(0, value)

    def acquire_data(self):
        print("Data acquisition triggered, wait...")
        try:
            result = subprocess.run(['./bpm_capture.sh'], check=False, capture_output=True, text=True)
#            result = subprocess.run(['./bpm_capture.sh'], check=True, capture_output=True, text=True)
            print(result.stdout)
        except subprocess.CalledProcessError as e:
            print(f"Error executing command: {e}")
            print(e.stderr)

    def analyse_single(self):
        fname=self.file_entry.get()
        fname2=self.file_entry2.get()
        tbtmode=int(self.mode1.get())
        in_tune=float(self.stune_var.get())
        print("Single TBT analyses from ",fname," triggered, mode=",tbtmode)
        self.aD.tbtMode=tbtmode
        self.aD.NT_tbt=int(self.turns_entry.get())
#        in_tune=self.aD.tune
        self.aD.analyse_sing(fname,fname2)
        out_tune=self.aD.tune
        sname=self.bpm_entry.get()
        amp=self.aD.fitDict[sname]["Amp"]
        phase=(self.aD.fitDict[sname]["Phi"]+self.aD.twiss[sname][3]*2*math.pi)%(2.0*math.pi)
        avamp=self.aD.ampin
        avphase=self.aD.phsin*180.0/math.pi   # displayed phase in degrees
        if avphase < 0.0: avphase += math.pi
        self.stune_var.delete(0,tk.END)
        self.stune_var.insert(0,str(self.aD.tune))
        self.ntune_var.delete(0,tk.END)
        self.ntune_var.insert(0,str(out_tune))
        self.ampin_var.delete(0,tk.END)
        self.ampin_var.insert(0,str(amp))
        self.phsin_var.delete(0,tk.END)
        self.phsin_var.insert(0,str(phase))

        self.avampin_var.delete(0,tk.END)
        self.avampin_var.insert(0,str(avamp))
        self.avphsin_var.delete(0,tk.END)
        self.avphsin_var.insert(0,str(avphase))

        self.update_plots_t(True)

    def update_plots_t(self, new=False):
        if(len(self.aD.data)==0):
            print("Update_plots(MainFrame): you have no data!")
            return
        Nt=int(self.turns_entry.get())
        sname=self.bpm_entry.get()
        strnew="false"
        if (new): strnew="true"
        print("Update plots: sname=",sname,Nt," new=",strnew)
        for i, ax in enumerate(self.axs):
            ax.cla()
            xmin = self.xmin_entries[i]
            xmax = self.xmax_entries[i]
 
            if i == 0:                
                y1=[]; 
                Nturns=self.aD.Nturns
                x1 = np.linspace(0, Nturns-1, Nturns)
                for ii in range(Nturns):
                    y1.append(self.aD.data[sname][ii])
                ax.plot(x1, y1, 'm')
                ax.set_title(sname+" amplitude")
                xmi=min(x1); xma=max(x1)
                if(new):
                    xmin.delete(0, tk.END)
                    xmax.delete(0, tk.END)
                    xmin.insert(0,str(xmi))
                    xmax.insert(0,str(xma))
                else:
                    ax.set_xlim(float(xmin.get()), float(xmax.get()))

            elif i == 1:
                if(len(self.aD.intn)==0):
                    print("No intensity data!")
                    continue
                y2=[]; 
                Nturns=self.aD.Nturns
                x2 = np.linspace(0, Nturns-1, Nturns)
                for ii in range(Nturns):
                    y2.append(self.aD.intn[sname][ii])
                ax.plot(x2, y2, 'm')
                ax.set_title(sname+" intensity")
                xmi=min(x2); xma=max(x2);
                ymi=0.0; yma=1.2*max(y2);
                ax.set_ylim(ymi,yma)
                if(new):
                    xmin.delete(0, tk.END)
                    xmax.delete(0, tk.END)
                    xmin.insert(0,str(xmi))
                    xmax.insert(0,str(xma))
                else:
                    ax.set_xlim(float(xmin.get()), float(xmax.get()))

            elif i==2:
                x3=[]; y3=[]; y31=[]; y32=[];
                for name in self.aD.bpmNames:
                    if (name not in self.aD.data.keys()): continue
                    if (name in self.aD.badList): continue
                    muX=self.aD.twiss[name][3]
                    av0=self.aD.avray0[name]
                    av=self.aD.avray[name]
                    err=self.aD.fitDict[name]["Err"]
                    x3.append(muX)
                    y3.append(av)
                    y31.append(av0)
                    y32.append(err)
                if(self.waveform_vars[i][0].get()):
                    ax.plot(x3, y3, 'b', marker='o',linestyle='None')
                if(self.waveform_vars[i][1].get()):
                    ax.plot(x3, y31, 'g', marker='o',linestyle='None')
                if(self.waveform_vars[i][2].get()):
                    ax.plot(x3, y32, 'y', marker='+',linestyle='None')
                ax.set_title("BPM offsets")
                xmi=min(x3); xma=max(x3)
                if(new):
                    xmin.delete(0, tk.END)
                    xmax.delete(0, tk.END)
                    xmin.insert(0,str(xmi))
                    xmax.insert(0,str(xma))
                else:
                    ax.set_xlim(float(xmin.get()), float(xmax.get()))

            elif i == 3:
                x43=[]; y43=[];
                x4=self.aD.signArr[0]
                y4=self.aD.signArr[1]
                y42=self.aD.signArr[2]
                y44=self.aD.signArr[3]
                if(self.waveform_vars[i][0].get()):
                    ax.plot(x4, y4,'b', marker='o',linestyle='None')
                    ax.plot(x4, y44,'r', marker='o',linestyle='None')
                if(self.waveform_vars[i][1].get()):
                    ax.plot(x4, y42, marker='+',linestyle='None')
                ax.plot(x43, y43, 'r', marker='o',linestyle='None')

                ax.set_title("Phase Shift/Sign")
                xmi=min(x4); xma=max(x4)
                if(new):
                    xmin.delete(0, tk.END)
                    xmax.delete(0, tk.END)
                    xmin.insert(0,str(xmi))
                    xmax.insert(0,str(xma))
                else:
                    ax.set_xlim(float(xmin.get()), float(xmax.get()))

            elif i==4:
                print("Plots: Read ",sname," NT=",Nt)
                ntfit=Nt*10
                y5=[]; y52=[]; y53=[];
                x5 = np.linspace(0, Nt-1,Nt)
                x52=np.linspace(0, ntfit-1,ntfit)*float(Nt/ntfit)
                for ii in range(Nt):
                    y5.append(self.aD.data[sname][ii])
                    y52.append(self.aD.fitDict[sname]["Fit"][ii])
                khi=self.aD.fitDict[sname]["Phi"]
                ampF=self.aD.fitDict[sname]["Amp"]
                for ii in range(ntfit):
                    phi=khi+2.0*math.pi*self.aD.tune*x52[ii]
                    y53.append(ampF*np.sin(phi)+self.aD.fitDict[sname]["Avr"])
                if(self.waveform_vars[i][0].get()):
                    ax.plot(x5, y5, 'g', marker='o',linestyle='None')
                if(self.waveform_vars[i][1].get()):
                    ax.plot(x5, y52, 'b', marker='o',linestyle='None')
                if(self.waveform_vars[i][2].get()):
                    ax.plot(x52, y53, 'b', marker='')
                    ax.set_title("TBT fit in "+sname)
                xmi=min(x5); xma=max(x5)
                if(new):
                    xmin.delete(0, tk.END)
                    xmax.delete(0, tk.END)
                    xmin.insert(0,str(xmi))
                    xmax.insert(0,str(xma))
                else:
                    ax.set_xlim(float(xmin.get()), float(xmax.get()))
                                
            else:
                for j, var in enumerate(self.waveform_vars[i]):
                    xall=[]; yall=[];
                    if var.get():
#                        phiL = self.aD.twiss[sname][3]
                        xpol=self.aD.fitDict[sname]["Phi0"]
                        ypol=self.aD.fitDict[sname]["Amp"]
                        ax.plot(xpol,ypol, 'r', marker='o', markersize=10)
                        xpolav=self.aD.phsin
                        ypolav=self.aD.ampin;
                        ax.plot(xpolav,ypolav, 'b', marker='o')
                        print("Inj Pol plot:", xpol, ypol, xpolav, ypolav)
                        for name in self.aD.fitDict.keys():
                            xall.append(self.aD.fitDict[name]["Phi0"])
                            yall.append(self.aD.fitDict[name]["Amp"])
                        ax.plot(xall,yall, 'g', marker='o',linestyle='',markersize=5)
                ax.set_title("Injection error")
#                ax.set_rmax(2.0)
#                ax.legend(loc='upper right')

        self.fig.tight_layout()
        self.canvas.draw()


class PlotFrame(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller

        font_small = ("TkDefaultFont", 8)

        label = tk.Label(self, text="Orbit fit Frame")
        label.grid(row=0, column=0, columnspan=2, pady=10)
#       label.pack(pady=10)

        # Variables for updating plots
        self.var3 = tk.IntVar(value=100)
        self.var4 = tk.StringVar(value="HP203")

        # data object
        self.aD=analyseData.get_instance()
        print("Fit Frame: AD instance ",self.aD.get_name()," fname ",self.aD.get_data_name())
        print("Data file not analysed here!")
        
        # Input Fields
        tk.Label(self, text="Number of Turns:").grid(row=1, column=0, padx=5, pady=5)
        tk.Entry(self, textvariable=self.var3).grid(row=1, column=1, padx=5, pady=5)

        tk.Label(self, text="BPM name:").grid(row=2, column=0, padx=5, pady=5)
        tk.Entry(self, textvariable=self.var4).grid(row=2, column=1, padx=5, pady=5)

        # Create the plot area
        self.fig, self.axs = plt.subplots(2, 2, figsize=(12, 6))
        self.canvas = FigureCanvasTkAgg(self.fig, self)
        self.canvas.get_tk_widget().grid(row=3, column=0, columnspan=2)

        # Button to update plots
        tk.Button(self, text="Update Plots", command=self.update_plots_p).grid(row=4, column=0, columnspan=2, pady=10)
#PlotFrame
        # Navigation Buttons
        tk.Button(self, text="TBT page", command=lambda: controller.show_frame("HomeFrame")).grid(row=5, column=0, columnspan=2, pady=10)
        tk.Button(self, text="Dev page", command=lambda: controller.show_frame("DevFrame")).grid(row=6, column=0, columnspan=2, pady=10)
        # Quit Button
        tk.Button(self, text="Exit", command=self.controller.quit, font=font_small).grid(row=7, column=0, columnspan=2, pady=10)
       # .pack(pady=5, fill='x')

        
        # Initial Plot
#        self.update_plots_p()

    def update_plots_p(self):
        if(len(self.aD.data)==0):
            print("Update_plots(PlotFrame): you have no data!")
            return
        nt=self.var3.get(); sname=self.var4.get();
        print("Plot Frame: Read ",sname," NT=",nt)

        xpl1=[]; zpl1=[]; zpl12=[]; zpl2=[]; zpl21=[];
        for i in range(self.aD.Nturns):
            xpl1.append(float(i))
            zpl1.append(self.aD.turnData[i]["Amp"])
            zpl12.append(self.aD.turnData[i]["Err"])
            zpl2.append(self.aD.turnData[i]["fMu"])
            zpl21.append(self.aD.turnData[i]["fMuA"])
        self.axs[0, 0].cla()
        self.axs[0, 0].plot(xpl1, zpl1, 'b')
        self.axs[0, 0].plot(xpl1, zpl12, 'r')
        self.axs[0, 0].set_title("Amplitudes/Errors")

        self.axs[0, 1].cla()
        self.axs[0, 1].set_ylim(0.6,0.7)
        self.axs[0, 1].plot(xpl1, zpl2, 'b')
        self.axs[0, 1].plot(xpl1, zpl21, 'g')
        self.axs[0, 1].set_title("Tunes")
        self.axs[0, 1].set_ylim(0.64, 0.67)

# PlotFrame

        xpl3=[]; zpl3=[]; zpl32=[]; zpl33=[];
        betaL=self.aD.twiss[sname][1]
        alphaL = self.aD.twiss[sname][2]
        phiL = self.aD.twiss[sname][3]
        fileN_sep=OUTPUT_DIR / "temp_sep_port.dat"
        file_sep=open(fileN_sep,"w")
        for kturn in range(nt):
            X0=self.aD.data[sname][kturn]/np.sqrt(betaL)
            Zloc=self.aD.calcLocalVector(phiL,betaL,alphaL,kturn)
            xn=Zloc.x[0]/np.sqrt(betaL)
            xpn=Zloc.x[1]*np.sqrt(betaL)+alphaL*xn
            xpl3.append(float(kturn))
            zpl3.append(xn)
            zpl32.append(xpn)
            zpl33.append(X0)
            str_out=str(kturn)+" "+str(xn)+" "+str(xpn)+" "+str(X0)+"\n"
            file_sep.write(str_out)
        file_sep.close()
            
        self.axs[1, 0].cla()
        self.axs[1, 0].plot(xpl3, zpl3, 'g')
        self.axs[1, 0].plot(xpl3, zpl33, 'b')
        self.axs[1, 0].set_title("Local fit X at "+sname)

        self.axs[1, 1].cla()
        self.axs[1, 1].plot(zpl3, zpl32, 'm', marker='o',linestyle='None')
        self.axs[1, 1].set_title("Local fit Phase space at "+sname)
        xmax=max(zpl32)*1.2
        self.axs[1, 1].set_xlim(-2*xmax, 2*xmax)
        self.axs[1, 1].set_ylim(-xmax, xmax)

        self.fig.tight_layout()
        self.canvas.draw()
#PlotFrame        
#        back_button1 = tk.Button(self, text="Back to Home", command=lambda: controller.show_frame("HomeFrame"))
#        back_button1.pack()

#        back_button2 = tk.Button(self, text="Back to Plot", command=lambda: controller.show_frame("PlotFrame"))
#        back_button2.pack()

class DevFrame(tk.Frame):
    def __init__(self, parent, controller):
        super().__init__(parent)
        self.controller = controller

        font_small = ("TkDefaultFont", 8)

        label = tk.Label(self, text="Dev Misc Frame")
        label.grid(row=0, column=0, columnspan=2, pady=10)
#       label.pack(pady=10)

        # Variables for updating plots
        self.var3 = tk.IntVar(value=400)
        self.var4 = tk.StringVar(value="HP203")

        # data object
        self.aD=analyseData.get_instance()
        print("Dev Frame: AD instance ",self.aD.get_name()," fname ",self.aD.get_data_name())
        
        # Input Fields
        tk.Label(self, text="Number of Turns:").grid(row=1, column=0, padx=5, pady=5)
        tk.Entry(self, textvariable=self.var3).grid(row=1, column=1, padx=5, pady=5)

        tk.Label(self, text="BPM name:").grid(row=2, column=0, padx=5, pady=5)
        tk.Entry(self, textvariable=self.var4).grid(row=2, column=1, padx=5, pady=5)

        # Create the plot area
        self.fig, self.axs = plt.subplots(2, 3, figsize=(12, 6))
        self.canvas = FigureCanvasTkAgg(self.fig, self)
        self.canvas.get_tk_widget().grid(row=3, column=0, columnspan=2)

        # Button to update plots
        tk.Button(self, text="Update Plots", command=self.update_plots_d).grid(row=4, column=0, columnspan=2, pady=10)

        # Navigation Button
        tk.Button(self, text="Home page", command=lambda: controller.show_frame("HomeFrame")).grid(row=5, column=0, columnspan=2, pady=10)
        tk.Button(self, text="Fit page", command=lambda: controller.show_frame("PlotFrame")).grid(row=6, column=0, columnspan=2, pady=10)

        # Quit Button
        tk.Button(self, text="Exit", command=self.controller.quit, font=font_small).grid(row=7, column=0, columnspan=2, pady=10)
       # .pack(pady=5, fill='x')

        
        # Initial Plot
#        self.update_plots_d()

    def update_plots_d(self):
        def tune_dft(yarr, ntt, nwid, npad=1, njmp=1):
            T=1.0/njmp; qbuf=[]; fDict={}
            nwidth=nwid*njmp; Nt=ntt*njmp
            if Nt > len(yarr):
                print(f"tune_dft: requested too long subarray {Nt}")
                return qbuff
            for k in range(ntt):
                if(k < nwid):
                    qbuf.append(0.0)
                    continue
                sig=yarr[k*njmp-nwidth:k*njmp]
                for j in range(nwidth,nwidth*npad): sig.append(0.0)
                fft_values = np.fft.fft(sig)
                fft_freqs = np.fft.fftfreq(nwidth*npad, T)
                pos_mask = fft_freqs >= 0.1
                freqs = fft_freqs[pos_mask]
                vals= np.abs(fft_values[pos_mask]) / nwidth
                if(njmp>1):
                    fDict[k]={}
                    fDict[k]["FX"]=freqs
                    fDict[k]["FF"]=vals
                Q=freqs[np.argmax(vals)]
                Qint=int(Q)
                Qfra=Q-Qint
                if Qfra<0.5 : Qfra=1-Qfra
                Q=Qint+Qfra
#                if(njmp>1): print(f" in tune_dft: njmp={njmp}, k={k}, Q={Q}")
                qbuf.append(Q)
            if(njmp>1):
                foutF=open(OUTPUT_DIR / "tempFFT.dat","w")
                for i in range(len(fDict[nwid]["FX"])):
                    strOut=f"{i}     "
                    for kw in fDict.keys():
                        str1=f"{fDict[kw]['FX'][i]:.3f} {fDict[kw]['FF'][i]:.3f} "
                        strOut +=str1
                    strOut +="\n"
                    foutF.write(strOut)
                foutF.close()
            return qbuf
            
        if(len(self.aD.data)==0):
            print("Update_plots(DevFrame): you have no data!")
            return
        nt=self.var3.get(); sname=self.var4.get();
        print("Dev Frame: Read ",sname," NT=",nt)

        xpl1=[]; zpl1=[]; zpl211=[]; zpl212=[]
        xpl12=[]; zpl12=[]; xpl13=[]; zpl13=[]
        xpl22=[]; zpl22=[]; xpl23=[]; zpl23=[]
        
        for i in range(nt):
            xpl1.append(float(i))
            zpl1.append(self.aD.data[sname][i])
            zpl211.append(self.aD.turnData[i]["fMu"])
            zpl212.append(self.aD.turnData[i]["fMuA"])
        self.axs[0, 0].cla()
        self.axs[0, 0].plot(xpl1, zpl1, 'b')
        self.axs[0, 0].set_title(f"TBT for {sname}")

        self.axs[1, 0].cla()
#        self.axs[1, 0].set_ylim(0.645,0.665)
        self.axs[1, 0].set_ylim(0.60,0.7)
        self.axs[1, 0].plot(xpl1, zpl211, 'b')
        self.axs[1, 0].plot(xpl1, zpl212, 'g')
        self.axs[1, 0].set_title("Fit Tunes FIT and FITA")
        
# DevFrame
        fs = 1.0  # Sampling frequency (Hz)
        T = 1/fs  # Sampling interval
        Ns = 32  # Number of samples
        Ns2=int(Ns/2)


# single turn fit
        iturn=1
        turndat=self.aD.turnData[iturn]
        ncoors=turndat["Xn"]
        nphis=turndat["Phi"]
        Npoints=len(ncoors)
        AR=turndat["Xsep"]
        BR=turndat["XsepP"]
        Nfit=200
        xfit=np.linspace(min(nphis),max(nphis),Nfit)
        pi2=2.0*np.pi
        zfit=[AR*np.cos(pi2*xf)+BR*np.sin(pi2*xf) for xf in xfit]
        self.axs[0, 1].cla()
        self.axs[0, 1].plot(nphis,ncoors, 'g',marker='o',linestyle='None')
        self.axs[0, 1].plot(xfit,zfit, 'b')
#        self.axs[0, 1].set_xlim(0.0,200.0)
#        self.axs[1, 0].xlabel("Frequency [Hz]")
#        self.axs[1, 0].ylabel("DFT abs")
        self.axs[0, 1].set_title(f"Orbit fit")
        
        
        
        qcrvs={}
        sumqna=[]
# M*N TBT BPM matrix use
        M=len(self.aD.data.keys())
        x_long=[]; xarr=[]
        print(f"full length {M*nt} nt={nt}")
        fileD=open(OUTPUT_DIR / "tempD.dat","w")
        lineNames="turn "; sp=" "
        for oname in self.aD.ordnames:
            lineNames +=oname+sp
        lineNames +="\n"
        fileD.write(lineNames)
        for i in range(nt):
            y_long=M*nt*[0];
            kn=0
            lineV=str(i)+sp
            for name in self.aD.ordnames:
                if (name in self.aD.badList):
                    lineV +="0.0"+sp
                    continue
                jind=i*M+kn
                y_long[jind]=self.aD.data[name][i]
                lineV +=str(self.aD.data[name][i])+sp
                kn +=1
            lineV +="\n"
            fileD.write(lineV)
            xarr=[k for k in range(i*M, M*(i+1))]
            x_long=x_long+xarr
        fileD.close()
        print(f"long arrays length {len(y_long)} {len(x_long)}")
        print(f"full length of good {kn} nt={nt}")
        print(f" MxN = {M*nt}")

        zpl12=y_long
        xpl12=x_long      
#        self.axs[0, 1].cla()
#        self.axs[0, 1].plot(xpl12, zpl12, 'g')
#        self.axs[0, 1].set_xlim(0.0,200.0)
##        self.axs[1, 0].xlabel("Frequency [Hz]")
##        self.axs[1, 0].ylabel("DFT abs")
#        self.axs[0, 1].set_title(f"M*N array, combined")

        Npad=16; Ns=32
        zpl13=tune_dft(y_long,nt, Ns, Npad, kn)
        print(f"returned array length={len(zpl13)} vs {nt}")
        xpl13=xpl1
        cut_list=np.array(zpl13[:Ns2])
        rem_list=np.array(zpl13[Ns2:])
        zpl13=np.concatenate([rem_list,cut_list])
        self.axs[0, 2].cla()
        self.axs[0, 2].plot(xpl13, zpl13, 'g')
#        self.axs[0, 2].set_ylim(9.60,9.7)
#        self.axs[0, 2].set_ylim(9.645,9.665)
        self.axs[0, 2].set_title(f"{kn}-Stacked tunes pad={Npad}, wind={Ns}")

        Npad=16
#        fs = 1.0  # Sampling frequency (Hz)
#        T = 1/fs  # Sampling interval
#        Ns = 64  # Number of samples

        zpl22=tune_dft(zpl1, nt, Ns, Npad)
        xpl22=xpl1        

        self.axs[1, 1].cla()
        self.axs[1, 1].plot(xpl22, zpl22, 'g')
        self.axs[1, 1].set_ylim(0.60,0.7)
#        self.axs[1, 1].set_ylim(0.645,0.665)
#        self.axs[1, 0].xlabel("Frequency [Hz]")
#        self.axs[1, 0].ylabel("DFT abs")
        self.axs[1, 1].set_title(f"DFT+padding{Npad}, {sname} ")

        qcrvs={}
        sumqna=[]
        Nnames=0; Npad=16; Ns=32; namesMax=10
        for name in self.aD.ordnames:
            if (name in self.aD.badList): continue
            yarr=self.aD.data[name]
            tunarr=tune_dft(yarr,nt, Ns, Npad)
            qcrvs[name]=tunarr
            sumqna.append(np.array(tunarr))
            print("Avrg checking: ",name," count=",Nnames,"vec=",tunarr[:50])
            Nnames +=1
            if(Nnames >=namesMax): break    

        zpl23 = np.mean(sumqna, axis=0)
        xpl23=xpl1      
        cut_list=np.array(zpl23[:Ns2])
        rem_list=np.array(zpl23[Ns2:])
        zpl23=np.concatenate([rem_list,cut_list])
        self.axs[1, 2].cla()
        self.axs[1, 2].plot(xpl1, zpl212, 'g')
        self.axs[1, 2].plot(xpl23, zpl23, 'r', linewidth=2.0)
 #       self.axs[1, 2].bar(xpl13, zpl13,width=0.005)
        self.axs[1, 2].set_ylim(0.60,0.7)
#        self.axs[1, 2].set_ylim(0.645,0.665)
        self.axs[1, 2].set_title(f"DFT tunes averaged (r) ")

        self.fig.tight_layout()
        self.canvas.draw()
        
