    def tbtFit(self,nt1,nt2):
        fitbuff={}; avTunCor=0.0; avX=0.0; avY=0.0; MODE=1;
        MODE=self.tbtMode
        def func(x,a,b,c,d):
            return a*np.sin(x*c+b)+d
        for name in self.data.keys():
            fitray={}; sqray={}; phiray={}; ampray={}; erray={}; baseray={};
            buf=[];
            SSX=0.0; SCX=0.0; SX=0.0; SCC=0.0; SSC=0.0; SSS=0.0; SX2=0.0;
            corfit=[]
            mu_bpm=self.twiss[name][3]     #the mu at BPM location
#            phi_bpm=2*self.PI*mu_bpm          # phase at BPM location
            if (MODE==1):
                #    using scipy fit
                xarr=[]; yarr=[];
                for i in range(nt1,nt2):
                    X=self.data[name][i]
                    phi=2.0*self.PI*self.tune*i
                    xarr.append(phi)
                    yarr.append(X)
# tbt fit for selected BPM in the range [nt1,nt2] turns
# fit for the curve x=A*sin(2*pi*Q*turn+Phi)
                in_guess=[5.0,0.0,1.0,0.0]
                bounds=([0.0,-math.pi,0.8,-10.0],[20.0,math.pi,1.2,10.0])
                popt,pcov = curve_fit(func, xarr, yarr,p0=in_guess, bounds=bounds,maxfev=20000)
                Amp,Phi,CR,DR=popt
#                print("Mode 1, ",name," A,Phi,CR,D=",Amp,Phi,CR,DR)
            else:
                # using custom MSQ fit Xfit=AR*sin(f_i)+BR*cos(f_i)
                for i in range(nt1,nt2):
                    X=self.data[name][i]
                    SX +=X
                DR=SX/(nt2-nt1);
                SX=0.0
                for i in range(nt1,nt2):
                    X=self.data[name][i]-DR
                    phi=2.0*self.PI*self.tune*i
                    CC=np.cos(phi)
                    SS=np.sin(phi)
                    SSX += X*SS
                    SCX += X*CC
                    SCC += CC*CC
                    SSS += SS*SS
                    SSC += SS*CC
                    SX += X
                    SX2 += X*X
                Den=(SSS*SCC-SSC*SSC)
                BR=(SSX*SCC-SCX*SSC)/Den
                AR=(SCX-BR*SSC)/SCC
                CR=1.0;    # no tune fitting in MODE 1
                Amp=math.sqrt(AR*AR+BR*BR)
                Phi=math.atan2(BR,AR)
            DDsv=0.0;
            for i in range(nt1,nt2):
                phi=2.0*self.PI*self.tune*i*CR
                CC=np.cos(phi)
                SS=np.sin(phi)
                Xsv=Amp*math.sin(phi+Phi)+DR
                Xme=self.data[name][i]
                DDsv +=(Xsv-Xme)**2
                corfit.append(Xsv)
            fitray["Fit"]=corfit
            avTunCor += CR
            Phi0 = Phi-(mu_bpm%1)*2.0*self.PI
            if(Phi0 < -self.PI): Phi0 +=2*self.PI
            Xinj = Amp*np.sin(Phi0)
            Yinj = Amp*np.cos(Phi0)
#            avTunCor += 1    # custom fit - no tune correction
            fitray["Err"]=math.sqrt(DDsv/float(nt2-nt1))                   # rms
            fitray["Amp"]=Amp                                     # amplitude
            fitray["Phi"]=Phi
            fitray["Phi0"]=Phi0
            fitray["Avr"]=DR
            fitbuff[name]=fitray
            avX +=Xinj
            avY +=Yinj
        avTunCor=avTunCor/len(self.data.keys())
        tune_new=avTunCor*self.tune
        avX = avX/len(self.data.keys())
        avY = avY/len(self.data.keys())
        avAmp = math.sqrt(avX*avX+avY*avY)
        avPhi = math.atan2(avX,avY)
        self.ampin=avAmp
        self.phsin=avPhi
        print("Tune tbtFit: seed tune=",self.tune," update =",tune_new," avPhi=",avPhi)
        self.tune=tune_new
        return fitbuff;      # tbtFit function 

    def calcOffsets(self):
        jbpm=0; buffer={};
        for BPMname in self.data.keys():
            AVR=self.fitDict[BPMname]["Avr"]
            buffer[BPMname]=AVR
            jbpm +=1
        return buffer

    def filterBPMs(self):
        for name in self.data.keys():
            if(abs(self.avray[name]) >= 20.0):   # checked only here
                self.badList.append(name)             # badList is not skipList
                if(self.DEBUG > 0.2):print("To BAD list: ",name," AVR=", self.avray[name])
        for i in range(self.Nturns):
            self.data[name][i] -= self.avray[name]
        #kludge!!!!
        self.badList.append("HP101")
        self.badList.append("HP113")
        self.badList.append("HP115")
        self.badList.append("HP505")
        self.badList.append("HP507")
        

    def signCheck(self):
        for name in self.bpmNames:
            if (name not in self.data.keys()):
                print("not in signCheck list:", name)
                continue
            if (name in self.badList): continue
            muX=self.twiss[name][3]
#            muF1=3.141593*(1-2.0*(muX%1))
            muF1=3.141593*(1-2.0*(muX))
            muF2=3.141593*(1-2.0*(0.5+muX-math.floor(muX+0.5)))
            phi=self.fitDict[name]["Phi"]
#            sign=-1.0
            sign=1.0
#            if(abs(phi-muF1)>abs(phi-muF2)): sign=1.0
            self.bpmSign[name]=sign
            self.signArr[0].append(muX)
            self.signArr[1].append(phi)
            dphi=phi-2.0*math.pi*(muX%1)
            if dphi < -math.pi : dphi += 2*math.pi
            self.signArr[3].append(dphi)
            self.signArr[2].append(self.bpmSign[name])
#            amp=self.fitDict[name]["Amp"]

    def calcLocalVector(self,phi0,beta0,alpha0,iturn):
        def funV(x,xarg):
            N=int(xarg[0])
            Z=0.0
            for i in range(N):
                Z += (xarg[i*3+2]*x[0]+xarg[i*3+3]*x[1]-xarg[i*3+1])**2.0
            return Z       
        jbpm=0; Lbpms=0; fargs=[]; matr=[];
        fargs.append(Lbpms)  # placeholder
        for name in self.data.keys():
            if(name not in self.bpmList): continue
            if(name in self.badList): continue
            beta=self.twiss[name][1]
            alpha=self.twiss[name][2]
            phi=self.twiss[name][3]
            dphi=2*self.PI*(phi-phi0)
            X=self.data[name][iturn]
            CC=np.cos(dphi)
            SS=np.sin(dphi)
            m11=np.sqrt(beta/beta0)*(CC+alpha0*SS)
            m12=np.sqrt(beta*beta0)*SS
            m21=-((alpha-alpha0)*CC+(1.0+alpha*alpha0)*SS)/np.sqrt(beta*beta0)
            m22=np.sqrt(beta0/beta)*(CC-alpha*SS)
            fargs.append(X)
            fargs.append(m11)
            fargs.append(m12)
            jbpm +=1
        Lbpms=jbpm
        fargs[0]=Lbpms
        Xinit=[0.0,0.0]
        Z_min=minimize(funV,Xinit,fargs)
        return Z_min

    def turnFit(self):
        anglePrev=0.0; dAngArr=[]; NavrTune=20; buffer={};
        for i in range(self.Nturns):
            buffer[i]={}
            Npoints=0
            SSX=0.0; SCX=0.0; SX=0.0; SCC=0.0; SSC=0.0; SSS=0.0; SX2=0.0;
            coorSep=[]; phiSep=[]; matrA=[];
#            for name in self.bpmList:
            for name in self.bpmNames:   # turned on temporarily for studies
                if (name not in self.data.keys()): continue
                if (name in self.badList): continue
                phi=self.twiss[name][3]
                CC=np.cos(2*self.PI*phi)
                SS=np.sin(2.0*self.PI*phi)
                matrA.append([CC,SS])
                beta=self.twiss[name][1]
                X=self.data[name][i]/np.sqrt(beta)*self.bpmSign[name]
                coorSep.append(X)
                phiSep.append(phi)
                Npoints +=1
            buffer[i]["Xn"]=coorSep
            buffer[i]["Phi"]=phiSep
            U,S,V=np.linalg.svd(matrA)
            AR=0.0; BR=0.0;
            for ir in [0,1]:
                for jr in range(Npoints):
                    AR += V[ir][0]/S[ir]*U[jr][ir]*coorSep[jr]
                    BR += V[ir][1]/S[ir]*U[jr][ir]*coorSep[jr]
            Amp=math.sqrt(AR*AR+BR*BR)
            angle=math.atan2(AR,-BR)
            Xsep=AR
            XsepP=BR
            sErr=0.0
            for j in range(Npoints):
                X=(coorSep[j]-AR*np.cos(2.0*self.PI*phiSep[j])-BR*np.sin(self.PI*phiSep[j]))
                sErr=+ X*X
            sErr=math.sqrt(sErr/Npoints)
            fitMu=-(angle-anglePrev)/2.0/self.PI
            if fitMu<0.0: fitMu=1.0+fitMu
            dAngArr.append(fitMu)
            fitMuA=0.0
            if(i>0):
                if (len(dAngArr)<NavrTune+1): mAvr=len(dAngArr)-1
                else: mAvr=NavrTune
                count=0
                for ka in range(i-mAvr+1,i+1):
                    fitMuA += dAngArr[ka]
                    count+=1
                fitMuA=fitMuA/mAvr
            buffer[i]["Xsep"]=Xsep
            buffer[i]["XsepP"]=XsepP
            buffer[i]["Err"]=sErr
            buffer[i]["Amp"]=Amp
            buffer[i]["fMu"]=fitMu
            buffer[i]["fMuA"]=fitMuA
            anglePrev=angle
        return buffer
    
    def analyse_sing(self, fname, fname2=""):
        readOK=False
        print("Class aD, processing file ",fname)
        self.bpmSign={}; self.badList=[]; self.skipList=[];
        self.data={}; self.intn={}; self.data2={};
        self.signArr=[[],[],[],[]];
        self.fname=fname;
        self.twiss=self.readTwissFunctions(self.TwissFileName);
        print("reading the position file",fname)
        self.data=self.readData(self.Nturns,self.fname,True);
        self.ordnames=self.orderNames()
        wpos=fname.find("pos")
        if(wpos>0):
            fnameI=fname.replace("pos","int")
            if(os.path.exists(fnameI)):
                print("reading the intensity file",fnameI)
                self.intn=self.readData(self.Nturns,fnameI)
            if(len(self.intn) >0): print("Intensity from ", fnameI," read, size ",len(self.intn))
        if(len(fname2) >0):
            if(os.path.exists(fname2)):
                print("Second file ",fname2, " exists")
                readOK=True
            else:
                print("Second file ",fname2, " not found")
                readOK=False
        if(readOK):
            print("reading the second file ",fname2)
            self.data2=self.readData(self.Nturns,fname2,False);
            self.refOrbits()
        else:
            print("skip reading the second file ",fname2)            
        self.avray0=self.calcRawOffsets();
        if(len(self.data2)>0):
            self.avray2=self.calcRawOffsets2();
# at this point not needed             
        print("Calling tbtFit ",self.NT_tbt, flush=True)
        self.fitDict= self.tbtFit(0,self.NT_tbt);
        self.signCheck();
        self.avray=self.calcOffsets();
        self.filterBPMs();
        self.turnData=self.turnFit()
        print("Data analysis complete")

class MainApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Delivery Ring Injection TBT")
        self.geometry("1400x1000")

        self.container = tk.Frame(self)
        self.container.pack(fill="both", expand=True)

        self.frames = {}
        for F in (HomeFrame, PlotFrame, DevFrame):
            frame = F(parent=self.container, controller=self)
            self.frames[F.__name__] = frame
            frame.grid(row=0, column=0, sticky="nsew")

        self.show_frame("HomeFrame")

    def show_frame(self, frame_name):
        frame = self.frames[frame_name]
        frame.tkraise()

