    def get_name(self):
        return self.name
            
    def set_data_name(self,fname):
        self.fname=fname
            
    def get_data_name(self):
        return self.fname
            
    def readTwissFunctions(self,tname):
        ilineT=0; bdict={};
        for line in open(tname):
            if line[0]=="#": continue
            words=line.split()
            index=int(words[0])
            elName=words[1]
            if(elName.find("iBPH")>-1): elName="HP"+elName[4:]
            Spos=float(words[2])*0.01
            betaX=float(words[3])*0.01
            alpX=float(words[4])
            muX=float(words[12])
#            if(elName in self.bpmNames):
            print("read TwissFunctions", elName)
            if(elName.find("HP")>=0):
                print(ilineT, " bpm Name ",elName," betaX=",betaX," muX=",muX)
                buffer=[Spos,betaX,alpX,muX]
                bdict[elName]=buffer
                ilineT +=1
        return bdict;

    def readData(self,nt,fname, firstFile=True):
        jbpm=0; buffer={}; jturn=-1; bpmNmsLoc=[];
        for strn in open(fname):   
            if(self.DEBUG > 0.9 and jturn < 10): print("String ", strn[:50])
            line=""; n=0
            for c in strn:
                code=ord(c)
                if(code==9): code=32; c=" ";
                if(code >31 and code < 128):
                    line +=c
                    n +=1
            words=line.split(",")
            if(self.DEBUG > 0.9):print("Mark 1:", len(words), words[0], words[1])
            if(jturn==-1):
                for word in words:      # first line - BPM names
                    word=word.replace('"','')
                    if (word.find("HF") >=0): word="HP"+word[3:6]
                    elif(word.find("HI") >=0):word="HP"+word[2:5]
###                    word="HP"+word[2:5]   # only for George data
                    if (word.find("HP") >=0):
                        BPMname=word
# store all BPMs in locl bpmNmsLoc, not self.bpmNames!
                        bpmNmsLoc.append(BPMname)
                        if(self.DEBUG > 0.4):print("Check 2:", jturn, word, BPMname)
                        if(not (BPMname in self.skipList)):
                            buffer[BPMname]=[]
                            jbpm +=1
                jturn +=1
            else:     # all other lines:  itrn, coordinates
                jwords=-1
                for word in words:
                    word=word.replace('"','')
                    jwords +=1
                    if(jwords==0): continue
                    if(jwords>=0):
                        BPMname=bpmNmsLoc[jwords-1]
                        try:
                            Z=float(word)
                        except ValueError:
                            print("ValueError:  BPM ", BPMname," data, bad word ",word)
                            Z=0.0
                        if(jturn<10 and self.DEBUG >0.9): print("Mark 2: ", jturn, jwords, word, BPMname,Z)
                        if(not (BPMname in self.skipList)):
                            buffer[BPMname].append(Z)
                jturn +=1
                if(jturn == nt): break
        if (firstFile): self.bpmNames=bpmNmsLoc
        return buffer

    def orderNames(self):
        muDict={}; ordnm=[];
        for bname in self.data.keys():
            muX=self.twiss[bname][3]
            muDict[muX]=bname
        muArr=list(muDict.keys())
        muArr.sort()
        for mx in muArr:
            name=muDict[mx]
            ordnm.append(name)
            print(f"Ordering names: {mx} {name}")
        return ordnm
        
    def calcRawOffsets(self):
        jbpm=0; buffer={};
        for BPMname in self.data.keys():
            coor=self.data[BPMname]
            AVR=sum(coor)/len(coor)
            buffer[BPMname]=AVR
#            print("Offset in BPM ",BPMname," =",AVR)
            for i in range(len(coor)):
                coor[i] -= AVR
            self.data[BPMname]=coor
        return buffer

    def calcRawOffsets2(self):
        jbpm=0; buffer={};
        for BPMname in self.data2.keys():
            coor=self.data2[BPMname]
            AVR=sum(coor)/len(coor)
            buffer[BPMname]=AVR
#            print("Offset in BPM ",BPMname," =",AVR)
            for i in range(len(coor)):
                coor[i] -= AVR
            self.data2[BPMname]=coor
        return buffer

